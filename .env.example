# ============================================
# 「搭配测试」环境变量模板
# 复制为 .env（本地 vercel dev 自动读取），切勿提交到 git！
# Vercel 线上：Dashboard → 项目 → Settings → Environment Variables
# ============================================

# --- Turso 数据库（必填，否则 API 走 mock 模式） ---
# 创建：turso db create dapei  →  turso db show dapei --url
TURSO_URL=libsql://dapei-你的用户名.turso.io
# 生成：turso db tokens create dapei
TURSO_AUTH_TOKEN=eyJhbGciOi...

# --- Vercel Blob 图片存储（上传接口用） ---
# 【推荐·无需手写 token】Dashboard → 项目 → Storage → Create Database → Blob
#   access 必须选 Public（衣橱图片要靠公开 URL 直接显示，且创建后不可改）
#   → Continue → 自动 Connect to Project，Vercel 自动注入 BLOB_STORE_ID + OIDC 凭证
# 【仅在需要 token 时才手写】Store → Tokens → Create Token → 勾 Public Access
#   代码在 Vercel 之外运行（本地脚本 / CI / 浏览器直传）才用得到
# 本地需要：vercel link && vercel env pull .env
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# --- 天气 API（第三阶段启用，和风天气或 OpenWeather） ---
WEATHER_API_KEY=
# 和风天气: https://dev.qweather.com  |  OpenWeather: https://openweathermap.org/api
WEATHER_PROVIDER=qweather

# --- LLM 润色推荐理由（第三阶段启用；缺省自动降级规则模板文案） ---
# OpenAI 兼容接口
LLM_API_KEY=
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.5-flash

# --- 私密模式门禁（App 设置 → 私密空间） ---
# 只存在服务端环境变量里，客户端安装包不含任何密码信息；
# 建议用 16 位以上随机串（终端生成：
#   openssl rand -base64 18  或  LC_ALL=C tr -dc A-Za-z0-9 </dev/urandom | head -c 20 ）。
# 修改后需 Redeploy 才生效；忘了密码 = 来这里改一个新值。
PRIVATE_MODE_PASSWORD=

# --- 私密图私有存储（🔒 身体部位图 / 私密相册） ---
# 为什么必须单独一个 store：Vercel Blob 的 access 是 **store 级**属性，
# 同一个 store 里没法一半 public 一半 private。要私密就得单建一个
# access=Private 的 store，Vercel 给它独立的环境变量前缀。
#
# 配置步骤（一次性）：
#   Vercel → 项目 → Storage → Create Storage → Blob
#   → access 选 **Private**
#   → Advanced Options → Environment Variable prefix 填 PRIVATE_BLOB_
#   → Continue（自动 Connect to Project，无需手写任何 token）
#   → Redeploy
#
# 连上后 Vercel 会自动注入 PRIVATE_BLOB_STORE_ID + OIDC 凭证。
# ⚠️ 未配置时私密图上传直接 503 拒绝，**不会**静默落公开 store——
#    回退等于私密照片以公开 URL 落盘，这次改造就白做了。
# 本地开发需 vercel env pull .env 把这两个变量拉下来。
PRIVATE_BLOB_STORE_ID=
# 仅当不用 OIDC（Store → Tokens → Create Token）时才需要：
PRIVATE_BLOB_READ_WRITE_TOKEN=

# 私密数据的 owner id（衣橱侧用的是 u_demo_0001，两边必须一致；
# 将来上多用户时改为从 token payload 解出）
PRIVATE_USER_ID=u_demo_0001
