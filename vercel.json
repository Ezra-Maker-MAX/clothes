{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    {
      "src": "api/gateway.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 30 }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/api/(?<action>[^/]+)", "dest": "/api/gateway.ts?action=$action" },
    { "src": "/api", "dest": "/api/gateway.ts" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
