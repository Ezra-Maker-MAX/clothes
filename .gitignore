# 依赖
node_modules/

# 环境变量（含数据库凭证，严禁提交）
.env
.env*.local

# 本地联调 SQLite（模拟 Turso 用）
local.db
local.db-shm
local.db-wal

# Vercel
.vercel/

# Flutter（第二阶段）
app/.dart_tool/
app/.flutter-plugins*
app/build/
app/.idea/

# 系统文件
.DS_Store
*.log

# ── Android release 签名材料（绝不入库）──
# keystore 私钥 + key.properties 口令 = 任何拿到仓库的人都能签出你的包顶替安装。
# 只提交 key.properties.example 模板，真实文件由你自己安全保管。
*.jks
*.keystore
*.p12
app/android/key.properties

# ── 姿势参考图原图（8.5MB，不入库）──
# 这些是第三方站点的图，用 scripts/poses/01-scrape.py 可在几分钟内重新抓取，
# 没必要塞进 git 历史（删掉也删不干净，只会永久占体积）。
# 需要重新导入 Blob 时：
#   python3 scripts/poses/01-scrape.py && python3 scripts/poses/02-normalize.py
#   cp /tmp/posedata/norm/*.webp assets/poses/img/
# 保留入库的是：assets/poses/index.json（清单）+ app/lib/services/pose_library_data.g.dart（生成的姿势数据）
assets/poses/img/
